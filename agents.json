{
  "$schema": "coding-agent-clean/agents.json",
  "description": "Single source of truth for the coding-agent-clean script. Lists every coding agent's local state paths per platform and which artifact categories (plugins, rules, skills, subagents, tools, mcps, hooks) it stores. Cloud-only agents are marked cloud_only and are skipped by the runner.",
  "artifact_categories": [
    "plugins",
    "rules",
    "skills",
    "subagents",
    "tools",
    "mcps",
    "hooks"
  ],
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "publisher": "Anthropic",
      "type": "cli",
      "cloud_only": false,
      "categories": [
        "plugins",
        "rules",
        "skills",
        "subagents",
        "tools",
        "mcps",
        "hooks"
      ],
      "notes": "Richest artifact surface of any agent. ~/.claude is the state root; override with CLAUDE_CONFIG_DIR.",
      "paths": {
        "windows": [
          "%USERPROFILE%\\.claude"
        ],
        "macos": [
          "~/.claude"
        ],
        "linux": [
          "~/.claude"
        ]
      },
      "project_local": [
        {
          "path": ".claude",
          "artifacts": [
            "rules",
            "skills",
            "subagents",
            "workflows",
            "agent-memory"
          ]
        },
        {
          "path": ".mcp.json",
          "artifacts": [
            "mcps"
          ]
        },
        {
          "path": "CLAUDE.md",
          "artifacts": [
            "memory"
          ]
        },
        {
          "path": "CLAUDE.local.md",
          "artifacts": [
            "memory"
          ]
        }
      ]
    },
    {
