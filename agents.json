{
  "$schema": "coding-agent-clean/agents.json",
  "description": "Single source of truth for the coding-agent-clean script. Lists every coding agent's local state paths per platform and which artifact categories (plugins, rules, skills, subagents, tools, mcps, hooks) it stores. Cloud-only agents are marked cloud_only and are skipped by the runner.",
  "artifact_categories": [
    "plugins",
    "rules",
    "skills",
    "subagents",
    "tools",
    "mcps",
    "hooks"
  ],
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "publisher": "Anthropic",
      "type": "cli",
      "cloud_only": false,
      "categories": [
        "plugins",
        "rules",
        "skills",
        "subagents",
        "tools",
        "mcps",
        "hooks"
      ],
      "notes": "Richest artifact surface of any agent. ~/.claude is the state root (%USERPROFILE%\\.claude on Windows).",
      "paths": {
        "windows": [
          "%USERPROFILE%\\.claude"
        ],
        "macos": [
          "~/.claude"
        ],
        "linux": [
          "~/.claude"
        ]
      },
      "project_local": [
        {
          "path": ".claude",
          "artifacts": [
            "rules",
            "skills",
            "subagents",
            "workflows",
            "agent-memory"
          ]
        },
        {
          "path": ".mcp.json",
          "artifacts": [
            "mcps"
          ]
        },
        {
          "path": "CLAUDE.md",
          "artifacts": [
            "memory"
          ]
        },
        {
          "path": "CLAUDE.local.md",
          "artifacts": [
            "memory"
          ]
        }
      ]
    },
    {
      "id": "codex",
      "name": "Codex",
      "publisher": "OpenAI",
      "type": "cli",
      "cloud_only": false,
      "categories": [
        "plugins",
        "rules",
        "skills",
        "subagents",
        "tools",
        "mcps",
        "hooks",
        "memory"
      ],
      "notes": "State root is $CODEX_HOME. Default: ~/.codex on ALL platforms (confirmed via dirs::home_dir() + '.codex'); Windows install.ps1 defaults to %USERPROFILE%\\.codex. Has skills, plugins, tools, hooks, mcps, memory. No distinct rules/subagents storage categories (subagents are a runtime feature; rules conflated with skills/hooks). Auth: $CODEX_HOME/auth.json (file-based default; keyring/auto/ephemeral modes exist). Project root detected via .git marker (NOT a .codex/ folder). Do NOT wipe packages/standalone/ (install root).",
      "paths": {
        "windows": [
          "%USERPROFILE%\\.codex"
        ],
        "macos": [
          "~/.codex"
        ],
        "linux": [
          "~/.codex"
        ]
      },
      "project_local": [
        {
          "path": ".codex/config.toml",
          "artifacts": [
            "config"
          ]
        },
        {
          "path": "AGENTS.md",
          "artifacts": [
            "rules"
          ]
        }
      ]
    },
